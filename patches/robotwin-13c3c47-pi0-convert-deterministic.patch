+def episode_number(path: str) -> int | None:
+    """k for episode_k.hdf5, which process_data.py writes from raw episode{k}.hdf5."""
+    match = re.fullmatch(r"episode_(\d+)\.hdf5", os.path.basename(path))
+    return int(match.group(1)) if match else None
+
+
+def episode_sort_key(path: str) -> tuple[bool, int, str]:
+    number = episode_number(path)
+    return (number is None, number or 0, path)
+
+
+def pick_instruction(instructions: list[str], seed: int, dataset_key: str, episode_file: str) -> int:
+    """Uniform pick like np.random.choice, fixed by (seed, dataset, episode file) on any run or machine."""
+    digest = hashlib.sha256(f"{seed}/{dataset_key}/{episode_file}".encode("utf-8")).digest()
+    return int.from_bytes(digest[:8], "big") % len(instructions)
+
+
