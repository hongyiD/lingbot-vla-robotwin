# Pod environment for LingBot training on the cluster. First time: cp /opt/embodiedx/k8s/k8s.env /mnt/work/k8s.env,
# adjust W / HF_LEROBOT_HOME if your PVC layout differs, then `source /mnt/work/k8s.env` in every new shell.
export D=/mnt/work                          # work PVC: configs, lists, logs, checkpoints, caches
export W=/mnt/weights                       # must contain lingbot-vla-v2-6b/ Qwen3-VL-4B-Instruct/ moge-2-vitb-normal/
export HF_LEROBOT_HOME=/mnt/data/lerobot    # converted LeRobot v3.0 datasets (use $D/lerobot if the data sits in work)
export LB=/opt/lingbot-vla-v2 EX=/opt/embodiedx
export CFG=$D/lingbot_cfg                   # robot_configs/robotwin_c50.yaml + norm_stats/robotwin_c50.json
export R=$D/reports
# datasets keeps a memory-mapped Arrow copy of every LeRobot dataset under $HF_HOME/datasets (about the data size)
export HF_HOME=$D/cache/hf XDG_CACHE_HOME=$D/cache/xdg
export TRITON_CACHE_DIR=$D/cache/triton TORCHINDUCTOR_CACHE_DIR=$D/cache/inductor TMPDIR=$D/tmp
mkdir -p "$R" "$D/configs" "$D/lists" "$D/smoke" "$D/runs" "$HF_HOME" "$XDG_CACHE_HOME" \
         "$TRITON_CACHE_DIR" "$TORCHINDUCTOR_CACHE_DIR" "$TMPDIR"
# Inference (deploy/lingbot_vla_v2_policy.py reset) only reads configs/robot_configs/<name>.yaml under the repo;
# the image filesystem resets with the Pod, so relink on every source
[ -f "$CFG/robot_configs/robotwin_c50.yaml" ] &&
  ln -sf "$CFG/robot_configs/robotwin_c50.yaml" "$LB/configs/robot_configs/robotwin_c50.yaml"

lb_run() {   # lb_run <GPU list> <port> <log> <script and args...>: torchrun from $LB, same env as train.sh;
             # the script runs through $D/bin/agx_run.py (faster chunk query for image-mode data, values unchanged)
  local gpus=$1 port=$2 log=$3
  shift 3
  mkdir -p "$(dirname "$log")"
  ( cd "$LB" && export TOKENIZERS_PARALLELISM=false HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 \
      TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 DISABLE_TELEMETRY=1 CUDA_VISIBLE_DEVICES=$gpus &&
    torchrun --nnodes 1 --nproc-per-node "$(tr ',' '\n' <<< "$gpus" | wc -l)" --master-addr 127.0.0.1 \
      --master-port "$port" "$D/bin/agx_run.py" "$@" > "$log" 2>&1 )
}

smoke_stats() {   # smoke_stats <log> [reference log]: steps, non-finite losses, median StepTime; step-1 loss diff
python3 - "$@" <<'PY'
import math, re, statistics, sys
def parse(path):
    steps = {}
    for line in open(path, errors="ignore"):
        m = re.search(r"Step (\d+)/\d+, ", line)
        if m:
            steps[int(m.group(1))] = {k: float(v) for k, v in
                                      re.findall(r"(\w+_Loss|StepTime) ([-+\d.eE]+|nan|inf)", line)}
    return steps
runs = [parse(p) for p in sys.argv[1:]]
for path, s in zip(sys.argv[1:], runs):
    bad = [n for n, v in s.items() if not all(math.isfinite(x) for x in v.values())]
    times = [v["StepTime"] for n, v in s.items() if n > 5 and "StepTime" in v]
    med = f"{statistics.median(times):.2f}s" if times else "n/a"
    print(f"{path}: steps {min(s, default=0)}..{max(s, default=0)}, non-finite {bad or 'none'}, median StepTime(>5) {med}")
if len(runs) == 2:
    a, b = runs[0].get(1), runs[1].get(1)
    if not a or not b:
        sys.exit("step 1 missing in one of the logs")
    for k in ("Depth_Loss", "Future_Depth_Loss", "FutureVideo_Loss", "VLA_Loss"):
        rel = abs(a[k] - b[k]) / max(abs(b[k]), 1e-8)
        verdict = "info" if k == "VLA_Loss" else "PASS" if rel < 0.02 else "CHECK" if rel < 0.05 else "FAIL"
        print(f"step1 {k:<18} {a[k]:.4f} vs {b[k]:.4f}  rel {rel:.2%}  {verdict}")
PY
}

step_wall() {   # step_wall <log>...: wall-clock seconds per step from the log timestamps, and the part spent outside
                # StepTime (StepTime starts after the batch is fetched, so this is mostly waiting for data)
python3 - "$@" <<'PY'
import datetime as dt, re, statistics, sys
for path in sys.argv[1:]:
    ts, st = {}, {}
    for line in open(path, errors="ignore"):
        m = re.search(r"(\d\d/\d\d/\d{4} \d\d:\d\d:\d\d) - .*?Step (\d+)/\d+, .*?StepTime ([\d.]+)s", line)
        if m:
            n = int(m.group(2))
            ts[n] = dt.datetime.strptime(m.group(1), "%m/%d/%Y %H:%M:%S")
            st[n] = float(m.group(3))
    steps = sorted(n for n in ts if n > 5)
    if len(steps) < 2:
        print(f"{path}: fewer than 2 steps after step 5")
        continue
    a, b, span = steps[0], steps[-1], steps[1:]
    wall = (ts[b] - ts[a]).total_seconds() / (b - a)
    mean = sum(st[n] for n in span) / len(span)
    slow = max(span, key=st.get)
    print(f"{path}: steps {a}..{b}: wall-clock {wall:.2f}s/step; StepTime mean {mean:.2f}s, "
          f"median {statistics.median(st[n] for n in span):.2f}s, max {st[slow]:.2f}s (step {slow}); "
          f"outside StepTime {wall - mean:+.2f}s/step")
PY
}
